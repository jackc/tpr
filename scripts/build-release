#!/usr/bin/env bash
# Build a release directory and tarball for one supported GOOS/GOARCH pair.

set -euo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

if [ "$#" -ne 2 ]; then
	echo "usage: scripts/build-release {linux|darwin} {amd64|arm64}" >&2
	exit 2
fi

target_os="$1"
target_arch="$2"

case "$target_os/$target_arch" in
	linux/amd64|linux/arm64|darwin/amd64|darwin/arm64) ;;
	*)
		echo "unsupported release target: $target_os/$target_arch" >&2
		exit 2
		;;
esac

target_dir="build/${target_os}_${target_arch}"
mkdir -p "$target_dir"

GOOS="$target_os" GOARCH="$target_arch" go build -o "$target_dir/tpr"

rm -rf "$target_dir/assets"
cp -R build/assets "$target_dir/assets"

version="$(git rev-parse HEAD)"
if [ -n "$(git status --porcelain)" ]; then
	version="${version}-dirty"
fi
printf '%s\n' "$version" > "$target_dir/VERSION"

tar -czf "${target_dir}.tar.gz" -C "$target_dir" .
